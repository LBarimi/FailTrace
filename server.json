{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.LBarimi/failtrace",
  "title": "FailTrace",
  "description": "Debugging experiments for coding agents: reproduce failures and verify fixes with test evidence.",
  "version": "1.4.0",
  "repository": {
    "url": "https://github.com/LBarimi/FailTrace",
    "source": "github"
  },
  "websiteUrl": "https://github.com/LBarimi/FailTrace#readme",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "failtrace",
      "version": "1.4.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--cwd",
          "description": "Absolute path to the project being investigated",
          "format": "filepath",
          "isRequired": true
        }
      ]
    }
  ]
}
